# このファイルを .env にコピーして値を入れてください（.env は絶対に公開しないこと）

# 楽天ウェブサービス https://webservice.rakuten.co.jp/ で「アプリID発行」
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天アフィリエイト https://affiliate.rakuten.co.jp/ のアフィリエイトID
RAKUTEN_AFFILIATE_ID=

# Instagram API with Instagram Login（Meta for Developers で取得）
IG_USER_ID=
IG_ACCESS_TOKEN=

# 画像とリンクページを公開する GitHub Pages の URL（末尾スラッシュなし）
# 例: https://yourname.github.io/insta-deals
PUBLIC_BASE_URL=
